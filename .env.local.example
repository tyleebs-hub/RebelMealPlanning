# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings > API). .env.local is gitignored.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
# Modern publishable key (starts sb_publishable_...). Safe to expose client-side.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# (legacy anon JWT key also works via NEXT_PUBLIC_SUPABASE_ANON_KEY)

# Added in phase 4 (auth):
# HOUSEHOLD_PASSWORD=
# ADMIN_PASSWORD=
