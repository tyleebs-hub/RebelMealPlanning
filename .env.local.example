# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings > API). .env.local is gitignored.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
# Modern publishable key (starts sb_publishable_...). Safe to expose client-side.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# (legacy anon JWT key also works via NEXT_PUBLIC_SUPABASE_ANON_KEY)

# Server-side only (never NEXT_PUBLIC). Used by the Paprika import script.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Auth (phase 4). The gate stays off until AUTH_SECRET and HOUSEHOLD_PASSWORD
# are both set. AUTH_SECRET signs the session cookie: any long random string.
AUTH_SECRET=long-random-string
HOUSEHOLD_PASSWORD=the-shared-household-password
ADMIN_PASSWORD=tylers-admin-password
