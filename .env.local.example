# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings > API). .env.local is gitignored.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
# Modern publishable key (starts sb_publishable_...). Safe to expose client-side.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# (legacy anon JWT key also works via NEXT_PUBLIC_SUPABASE_ANON_KEY)

# Server-side only (never NEXT_PUBLIC). Used by the Paprika import script.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Auth. One shared password gets you in with full access — there is no admin
# tier. The gate stays off until AUTH_SECRET and a password are set.
# AUTH_SECRET signs the session cookie: any long random string.
# NOTE: quote any password containing # (a bare # is read as a comment).
AUTH_SECRET=long-random-string
HOUSEHOLD_PASSWORD="the-shared-password"
# ADMIN_PASSWORD is no longer a separate tier; if set, it's just accepted as a
# second valid password. Safe to remove.

# AI suggestions (optional). Server-side only. When set, the week view shows a
# "Generate plan" button and dinner slots get an AI swap control (also on the
# vote page). Uses Claude Sonnet 4.6 through the Anthropic API. Without it, the
# app works exactly as before and the AI controls stay hidden.
ANTHROPIC_API_KEY=sk-ant-xxx
